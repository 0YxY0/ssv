# =============================================================================
# Site Safety Vision — 环境变量配置
# =============================================================================
# 复制此文件为 .env 并按需修改:
#   cp .env.example .env
#
# shell 脚本通过 scripts/lib.sh 自动加载 .env
# Docker Compose 自动读取项目根目录的 .env
# Python agent 通过 python-dotenv 加载 .env
# =============================================================================

# ─── 运行配置入口 ─────────────────────────────────────────────────────────────
# 默认优先读取项目根目录 ssv.yaml，其次 config/ssv.yaml，最后回退到 config/ssv.example.yaml。
# 如需临时切换整份配置文件，设置 SSV_CONFIG_PATH。
# SSV_CONFIG_PATH=config/ssv.yaml

# GStreamer 调试级别，临时覆盖 logging.cpp_debug_level。
# GST_DEBUG=ssv*:4

# 临时覆盖 sources[0].uri；长期配置请写入 config/ssv.yaml。
# SSV_RTSP_URL=rtsp://user:pass@host:554/stream

# Redis 部署环境常用覆盖；长期本地配置可写入 config/ssv.yaml。
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ─── Qdrant (M7 启用) ────────────────────────────────────────────────────────
# QDRANT_PORT=6333

# ─── 构建配置：通用 ───────────────────────────────────────────────────────────
# 自定义 Meson 构建目录；默认 build。
# SSV_BUILD_DIR=build

# 额外 pkg-config 搜索路径；用于本地解包的 GStreamer/yaml-cpp/hiredis 等基础依赖。
# SSV_EXTRA_PKG_CONFIG_PATH=/path/to/pkgconfig

# CUDA Toolkit 根目录；TensorRT 编译时需要 cuda_runtime_api.h 和 libcudart.so。
# 未设置时脚本会尝试 /usr/local/cuda 和 /usr/local/cuda-*。
# CUDA_HOME=/usr/local/cuda

# ─── 构建配置：ONNX Runtime CPU ───────────────────────────────────────────────
# 默认 CPU 包会下载到 .deps/onnxruntime。
# SSV_ONNXRUNTIME_FLAVOR=cpu
# SSV_ONNXRUNTIME_VERSION=1.25.1
# SSV_ONNXRUNTIME_ROOT=.deps/onnxruntime

# ─── 构建配置：ONNX Runtime GPU ───────────────────────────────────────────────
# GPU 包会下载到 .deps/onnxruntime-gpu；CUDA/cuDNN 运行库仍需本机或仓库本地依赖可见。
# scripts/lib.sh 会自动把 .deps/python-site-packages/nvidia/*/lib 和 .deps/venvs/*/site-packages/nvidia/*/lib 加入 LD_LIBRARY_PATH。
# SSV_ONNXRUNTIME_FLAVOR=gpu
# SSV_ONNXRUNTIME_VERSION=1.25.1
# SSV_ONNXRUNTIME_ROOT=.deps/onnxruntime-gpu

# ─── 构建配置：TensorRT ───────────────────────────────────────────────────────
# TensorRT 构建模式：auto、enabled、disabled。
# auto: 仓库本地路径有可用 TensorRT SDK 时启用；没有时编译占位后端。
# enabled: 必须通过 SSV_TENSORRT_ROOT、SSV_TENSORRT_ARCHIVE 或 SSV_TENSORRT_URL 显式提供 SDK，否则构建失败。
# disabled: 不编译 TensorRT 后端。
# SSV_TENSORRT=auto

# 推荐方式：使用者按本机 CUDA/driver/engine 版本选择 TensorRT SDK，解包到仓库 .deps 下。
# SSV_TENSORRT=enabled
# SSV_TENSORRT_ROOT=.deps/tensorrt
# SSV_TENSORRT_ARCHIVE=/path/to/TensorRT-*-Linux-x86_64-*.tar.zst
# SSV_TENSORRT_VERSION=11.1.0.106

# URL 方式：显式指定 TensorRT SDK 归档 URL，让脚本下载并解包到 SSV_TENSORRT_ROOT。
# 项目不会自动选择 TensorRT 版本；请按本机 CUDA/driver/engine 兼容性选择 URL。
# SSV_TENSORRT_URL=https://developer.nvidia.com/downloads/compute/machine-learning/tensorrt/11.0.0/tars/TensorRT-Enterprise-11.0.0.114-Linux-x86_64-cuda-13.2-Release-external.tar.zst
