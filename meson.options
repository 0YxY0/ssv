option('tests', type : 'boolean', value : false, description : 'Build tests')
option('tensorrt_mode', type : 'combo', choices : ['auto', 'enabled', 'disabled'], value : 'auto',
  description : 'Build TensorRT inference backend when the SDK is available')

option('opencv_mode', type : 'combo', choices : ['enabled', 'disabled'], value : 'enabled',
  description : 'Build OpenCV-based GMC when the local OpenCV SDK is enabled')

option('deps_runtime_path', type : 'string', value : '',
  description : 'Colon-separated runtime library path resolved by the Python dependency service')

option('onnxruntime_profile', type : 'combo',
  choices : ['cpu', 'nvidia', 'intel', 'amd'], value : 'cpu',
  description : 'Resolved ONNX Runtime Provider profile from the dependency snapshot')

option('onnxruntime_dependency_signature', type : 'string', value : '',
  description : 'SHA-256 identity of the resolved Provider and runtime dependency snapshot')
